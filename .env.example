# ─────────────────────────────────────────────────────────────
#  Adaptive RL CPU Scheduler — Environment Variables Template
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# ── Database ─────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=sqlite+aiosqlite:///./data/scheduler.db

# PostgreSQL (for production/Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/scheduler_db

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── RL Agent ─────────────────────────────────────────────────
RL_MODEL_PATH=rl_agent/models/ppo_cpu_scheduler
RL_TRAINING_TIMESTEPS=500000
RL_N_ENVS=4

# ── Simulation ───────────────────────────────────────────────
MAX_PROCESSES=50
MAX_CORES=8
DEFAULT_TIME_QUANTUM=4

# ── Export ───────────────────────────────────────────────────
EXPORT_DIR=./exports
